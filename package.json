{
  "name": "loanslam-turnplanner-core",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "build": "npm --workspaces --if-present run build",
    "format:check": "prettier --check \"package.json\" \"package-lock.json\" \"tsconfig*.json\" \"vitest.config.ts\" \"packages/**/*.{ts,vue,css,html}\" \"packages/**/package.json\" \"packages/**/tsconfig.json\"",
    "core:turn": "tsx packages/core/src/cli.ts turn",
    "core:simulate": "tsx packages/core/src/cli.ts simulate",
    "core:compare": "tsx packages/core/src/cli.ts compare",
    "core:persona-simulate": "tsx packages/core/src/cli.ts persona-simulate",
    "core:stochastic": "tsx packages/core/src/cli.ts stochastic",
    "core:chat": "tsx packages/core/src/cli.ts chat",
    "core:serve": "tsx packages/core/src/cli.ts serve",
    "lab-ui:dev": "npm --workspace @loanslam/lab-ui run dev",
    "lab-ui:build": "npm --workspace @loanslam/lab-ui run build"
  },
  "dependencies": {
    "openai": "^6.9.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24"
  }
}
