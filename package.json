{
  "name": "loanslam-turnplanner-core",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run source-policy:check && vitest run",
    "typecheck": "npm run source-policy:check && npm --workspaces --if-present run typecheck",
    "build": "npm run source-policy:check && npm --workspaces --if-present run build",
    "source-policy:check": "tsx scripts/check-typescript-source-policy.ts",
    "verify": "npm test && npm run typecheck && npm run build",
    "floor-delta": "tsx scripts/floor-delta.ts",
    "gate-slice": "tsx scripts/gate-slice.ts",
    "digest": "tsx scripts/digest.ts",
    "branch-risk": "tsx scripts/branch-risk.ts",
    "start": "tsx packages/core/src/cli.ts serve --demo-only --host 0.0.0.0 --demo-static-host-root packages/review-host/dist --demo-static-widget-root packages/review-widget/dist",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run review-widget:build && npm run review-host:build",
    "format:check": "prettier --check \"package.json\" \"package-lock.json\" \"prisma.config.ts\" \"tsconfig*.json\" \"vitest.config.ts\" \"api/**/*.ts\" \"packages/**/*.{ts,vue,css,html}\" \"packages/**/package.json\" \"packages/**/tsconfig.json\"",
    "core:turn": "tsx packages/core/src/cli.ts turn",
    "core:simulate": "tsx packages/core/src/cli.ts simulate",
    "core:compare": "tsx packages/core/src/cli.ts compare",
    "core:persona-simulate": "tsx packages/core/src/cli.ts persona-simulate",
    "core:stochastic": "tsx packages/core/src/cli.ts stochastic",
    "core:route-audit": "tsx packages/core/src/cli.ts route-audit",
    "core:hell-week": "tsx packages/core/src/cli.ts hell-week",
    "core:hell-week-review": "tsx packages/core/src/cli.ts hell-week-review",
    "core:hell-week-judge": "tsx packages/core/src/cli.ts hell-week-judge",
    "core:hell-week-judge-calibrate": "tsx packages/core/src/cli.ts hell-week-judge-calibrate",
    "core:hell-week-compare": "tsx packages/core/src/cli.ts hell-week-compare",
    "core:hell-week-stability": "tsx packages/core/src/cli.ts hell-week-stability",
    "core:chat": "tsx packages/core/src/cli.ts chat",
    "core:serve": "tsx packages/core/src/cli.ts serve",
    "core:demo-log": "tsx packages/core/src/cli.ts demo-log",
    "mcp:lab-api": "tsx packages/mcp-server/src/server.ts",
    "lab-ui:dev": "sh -c 'npm --prefix packages/lab-ui run dev -- \"$@\"' --",
    "lab-ui:build": "npm --workspace @loanslam/lab-ui run build",
    "demo-widget:dev": "npm --workspace @loanslam/demo-widget run dev",
    "demo-widget:build": "npm --workspace @loanslam/demo-widget run build",
    "demo-host:dev": "npm --workspace @loanslam/demo-host run dev",
    "demo-host:build": "npm --workspace @loanslam/demo-host run build",
    "review-widget:dev": "npm --workspace @loanslam/review-widget run dev",
    "review-widget:build": "npm --workspace @loanslam/review-widget run build",
    "review-host:dev": "npm --workspace @loanslam/review-host run dev",
    "review-host:build": "npm --workspace @loanslam/review-host run build"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "openai": "^6.9.1",
    "pg": "^8.22.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "prettier": "^3.7.4",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "prisma": {
      "@prisma/dev": "0.24.9"
    }
  }
}
