# Loanslam chat widget — local configuration.
# Copy to .env and fill in. The real .env (with live keys) is git-ignored.

# ── Server ────────────────────────────────────────────────────────────────
PORT=8787
NODE_ENV=development
LOG_LEVEL=info
# Origin allowed to embed the widget / call the API (CORS + CSRF origin check).
WIDGET_ORIGIN=http://localhost:5173

# ── AI provider (OpenAI-compatible) ───────────────────────────────────────
# Any OpenAI-compatible endpoint works: OpenAI, OpenRouter, local gateways.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Master switch. When false, every model-backed step uses its deterministic
# fallback (vulnerability gate still fails CLOSED). Lets the POC run offline.
AI_ENABLED=true

# ── Retrieval / grounding ─────────────────────────────────────────────────
# Minimum lexical match score (0..1) for an answer to be considered grounded.
GROUNDING_THRESHOLD=0.42

# ── Persistence ───────────────────────────────────────────────────────────
# memory  -> file-backed in-memory store (default; zero-friction demo)
# sqlserver -> Prisma + SQL Server (production target; requires DATABASE_URL)
PERSISTENCE=memory
DATA_DIR=./.data
# DATABASE_URL="sqlserver://localhost:1433;database=loanslam;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# ── Ticket / handoff webhook ──────────────────────────────────────────────
# When unset, the webhook adapter records the ticket payload to the audit
# trail instead of POSTing (demo-safe). Set to a real URL to POST.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_TOKEN=

# ── Security ──────────────────────────────────────────────────────────────
# Secret used to sign session cookies / derive the conversation reference.
SESSION_SECRET=dev-only-change-me
