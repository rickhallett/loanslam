{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "topFilesLength": 20
  },
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "repomix-output.*",
      "packages/review-host/public/reports/**",
      "site/**",
      "docs/prds/**",
      "docs/reports/**",
      "artifacts/**",
      "secrets/**",
      "scripts/throwaway/**",
      "scripts/*probe*"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}
