---
import ApplicationJourney from '../components/ApplicationJourney.vue';
import Base from '../layouts/Base.astro';
---

<Base
  title="Apply for a Loans by MAL loan"
  description="Apply online for a Loans by MAL instalment loan."
>
  <div class="page-head apply-head">
    <div class="ripples"></div>
    <div class="container apply-head-grid">
      <div>
        <p class="crumb"><a href="/">Home</a> / Apply</p>
        <h1>Apply for a Loans by MAL loan</h1>
        <p>
          Borrow £1,000 to £5,000 over up to 36 months. Start with your details and
          move through the same calm, secure journey as the rest of the site.
        </p>
      </div>
      <ul class="apply-signals" aria-label="Application trust signals">
        <li>Direct lender, not a broker</li>
        <li>FCA authorised and regulated</li>
        <li>No hidden fees or charges</li>
      </ul>
    </div>
  </div>

  <ApplicationJourney client:load />
</Base>

<style>
  .apply-head-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
  }

  .apply-signals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .apply-signals li {
    position: relative;
    padding-left: 1.85rem;
    color: #fff;
    font-weight: 800;
  }

  .apply-signals li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.05rem;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    background: var(--amber-400);
    color: var(--ink-950);
    font-size: 0.75rem;
  }

  @media (max-width: 760px) {
    .apply-head-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
