---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact | LoanSlam"
  description="Request a private LoanSlam demo or discuss regulated-lending AI evaluation."
>
  <section class="page-header">
    <div class="container narrow">
      <p class="eyebrow">Contact</p>
      <h1>Use the existing project channel for private demos.</h1>
      <p class="lede">
        LoanSlam is not a public lending service. Demo conversations run on synthetic scenarios and
        should be reviewed as product evidence, not customer support.
      </p>
      <a class="btn btn--primary" href="/">Back to overview</a>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <article class="card">
        <h2>Good demo fit</h2>
        <p>
          Regulated support teams, product owners, and compliance reviewers who want to inspect how
          an AI turn is planned, grounded, blocked, or escalated.
        </p>
      </article>
      <article class="card">
        <h2>Not in scope</h2>
        <p>
          Real applicant intake, live affordability decisions, payment handling, or any flow that
          would collect production personal data.
        </p>
      </article>
    </div>
  </section>
</Base>
