---
import Base from '../layouts/Base.astro';
import { notFoundCopy } from '../lib/site-copy.ts';
---

<Base title={notFoundCopy.title}>
  <div class="page-head">
    <div class="ripples"></div>
    <div class="container" style="position: relative;">
      <p class="crumb" set:html={notFoundCopy.head.crumbHtml} />
      <h1>{notFoundCopy.head.title}</h1>
      <p set:html={notFoundCopy.head.bodyHtml} />
    </div>
  </div>
</Base>
