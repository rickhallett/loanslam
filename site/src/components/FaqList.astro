---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq-list">
  {
    items.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <div class="faq-body" set:html={item.a} />
      </details>
    ))
  }
</div>
