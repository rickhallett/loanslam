{
  "$schema": "https://loanslam.local/schemas/secrets-manifest.v1.json",
  "description": "Secret names and deploy targets only. Values live in encrypted secrets/*.env.sops files.",
  "environments": {
    "local": {
      "encryptedFile": "secrets/local.env.sops",
      "plaintextFile": ".env.local"
    },
    "staging": {
      "encryptedFile": "secrets/staging.env.sops",
      "plaintextFile": ".env.staging"
    },
    "production": {
      "encryptedFile": "secrets/production.env.sops",
      "plaintextFile": ".env.production"
    }
  },
  "deployTargets": {
    "vercel": {
      "staging": {
        "environment": "preview",
        "gitBranch": "staging"
      },
      "production": {
        "environment": "production"
      }
    },
    "railway": {
      "staging": {
        "environment": "staging"
      },
      "production": {
        "environment": "production"
      }
    }
  },
  "variables": {
    "ANTHROPIC_API_KEY": {
      "providerPolicy": {
        "allowlisted": true,
        "reason": "Legacy encrypted carryover only; not required by project runtime and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "AWS_BEARER_TOKEN_BEDROCK": {
      "providerPolicy": {
        "allowlisted": true,
        "reason": "Legacy encrypted carryover only; not required by project runtime and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "CLAUDE_CODE_OAUTH_TOKEN": {
      "providerPolicy": {
        "nonInference": true,
        "reason": "Agent CLI credential only; not project runtime inference and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "DATABASE_URL": {
      "required": ["local", "staging", "production"],
      "secret": true,
      "targets": ["vercel", "railway"]
    },
    "DATABASE_URL_UNPOOLED": {
      "required": ["local", "staging", "production"],
      "secret": true,
      "targets": ["vercel", "railway"]
    },
    "DEMO_INTERACTION_DATABASE_URL": {
      "required": ["local"],
      "secret": true,
      "targets": ["vercel", "railway"]
    },
    "DEMO_STATE_TOKEN_SECRET": {
      "required": ["staging", "production"],
      "secret": true,
      "targets": ["vercel", "railway"]
    },
    "GEMINI_API_KEY": {
      "providerPolicy": {
        "allowlisted": true,
        "reason": "Legacy encrypted carryover only; not required by project runtime and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "GOOGLE_API_KEY": {
      "providerPolicy": {
        "allowlisted": true,
        "reason": "Legacy encrypted carryover only; not required by project runtime and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "OPENAI_API_KEY": {
      "required": ["local", "production"],
      "secret": true,
      "targets": ["railway"]
    },
    "OPENROUTER_API_KEY": {
      "providerPolicy": {
        "allowlisted": true,
        "reason": "Legacy encrypted carryover only; not required by project runtime and not deployed."
      },
      "required": [],
      "secret": true,
      "targets": []
    },
    "REPORTS_ACCESS_KEY": {
      "required": ["local", "production"],
      "secret": true,
      "targets": ["railway"]
    },
    "REPORTS_AUTH_DISABLED": {
      "required": [],
      "secret": false,
      "targets": ["railway"]
    },
    "REPORTS_SESSION_SECRET": {
      "required": ["local", "production"],
      "secret": true,
      "targets": ["railway"]
    },
    "TAVILY_API_KEY": {
      "required": [],
      "secret": true,
      "targets": []
    },
    "WAFER_API_KEY": {
      "required": ["local"],
      "secret": true,
      "targets": []
    }
  }
}
